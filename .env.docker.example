# Copia este archivo a .env (junto a docker-compose.yml) y completa los valores.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esto

# --- JWT (secretos largos y aleatorios, distintos entre sí) -------------------
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=otro-secreto-largo-y-aleatorio
# JWT_ACCESS_EXPIRES_IN=900
# JWT_REFRESH_EXPIRES_IN=604800

# --- Seeds (los ejecuta el servicio `migrate` en cada `docker compose up`) ----
# true crea admin@huertohogar.cl / admin1234 y cliente@correo.cl / cliente123
SEED_DEMO_USERS=false
# Si se definen ambos, crea este administrador (contraseña de 8+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- API Gateway ---------------------------------------------------------------
GATEWAY_PORT=3000
# Orígenes del frontend separados por coma. Vacío = puertos de Vite en localhost.
# CORS_ORIGINS=http://mi-bucket.s3-website-us-east-1.amazonaws.com

# --- Imágenes de productos -----------------------------------------------------
# local: se guardan en el volumen `uploads` y el gateway las sirve en /uploads
STORAGE_DRIVER=local
ASSETS_BASE_URL=http://localhost:3000/uploads

# AWS (en EC2 los permisos vienen del rol de la instancia, sin claves):
# STORAGE_DRIVER=s3
# S3_BUCKET=huerto-hogar-imagenes
# AWS_REGION=us-east-1
# ASSETS_BASE_URL=https://huerto-hogar-imagenes.s3.us-east-1.amazonaws.com
