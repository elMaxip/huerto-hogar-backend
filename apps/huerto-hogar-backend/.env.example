# API Gateway (HTTP)
PORT=3000
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

USERS_SERVICE_HOST=localhost
USERS_SERVICE_PORT=3001
PRODUCTS_SERVICE_HOST=localhost
PRODUCTS_SERVICE_PORT=3002
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3003

# Orígenes del frontend permitidos por CORS, separados por coma.
# Si no se define, se permiten los puertos de desarrollo de Vite (5173-5177).
# CORS_ORIGINS=https://huertohogar.cl,https://shop.huertohogar.cl

# --- Almacenamiento de imágenes -------------------------------------------
# Desarrollo: las imágenes se guardan en ./uploads y este servidor las sirve en /uploads
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
ASSETS_BASE_URL=http://localhost:3000/uploads

# Producción en AWS (debe coincidir con apps/products-service/.env):
# STORAGE_DRIVER=s3
# S3_BUCKET=huerto-hogar-imagenes
# AWS_REGION=us-east-1
# URL pública desde la que se ven las imágenes. Sin definir usa
# https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com; con CloudFront pon su dominio:
# ASSETS_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
# En EC2 no pongas claves de acceso: asigna a la instancia un rol IAM con
# s3:PutObject y s3:DeleteObject sobre arn:aws:s3:::<bucket>/products/*
