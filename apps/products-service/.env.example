DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=products_db

# Almacenamiento de imágenes: misma configuración que el gateway.
# products-service arma las URLs públicas y borra las imágenes reemplazadas.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
ASSETS_BASE_URL=http://localhost:3000/uploads

