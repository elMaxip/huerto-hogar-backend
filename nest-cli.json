{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/huerto-hogar-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/huerto-hogar-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/huerto-hogar-backend",
  "projects": {
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "huerto-hogar-backend": {
      "type": "application",
      "root": "apps/huerto-hogar-backend",
      "entryFile": "main",
      "sourceRoot": "apps/huerto-hogar-backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/huerto-hogar-backend/tsconfig.app.json"
      }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users-service/tsconfig.app.json"
      }
    }
  }
}